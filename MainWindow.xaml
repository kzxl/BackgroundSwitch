<Window x:Class="BackgroundSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BackgroundSwitch — Multi-Monitor Wallpaper Changer" Height="680" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#1E1E2E" Foreground="#CDD6F4"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Dark Theme Control Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2E2E44"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#3E3E58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#89B4FA"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2E2E44"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#3E3E58"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E58"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B4BEFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#74C7EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5C2E7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBA0AC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Monitor Mode & Scale Card -->
                <RowDefinition Height="Auto"/> <!-- Global Source Card -->
                <RowDefinition Height="Auto"/> <!-- Per-Monitor List Card -->
                <RowDefinition Height="Auto"/> <!-- General Settings Card -->
                <RowDefinition Height="Auto"/> <!-- Blacklist Management Card -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header with Language Selector -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="lblAppTitle" Text="🖼️ BackgroundSwitch" FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
                    <TextBlock x:Name="lblAppSubtitle" Text="Tự động đổi hình nền đa màn hình &amp; Tối ưu hiệu năng cao (.NET 10)" FontSize="13" Foreground="#A6ADC8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblLanguage" Text="🌐 Ngôn ngữ:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbLanguage" Width="140" SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="Song ngữ (Bilingual)" Tag="bilingual"/>
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- 2. Monitor Mode & Scaling Card -->
            <Border Grid.Row="1" Background="#252538" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#3E3E58" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="lblModeSection" Text="🖥️ Chế độ Hiển thị &amp; Tỉ lệ màn hình" FontWeight="Bold" FontSize="14" Foreground="#89B4FA" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="rbModeSynced" Grid.Column="0" Content="Đồng bộ (1 ảnh)" Checked="Mode_Changed"/>
                        <RadioButton x:Name="rbModePerMonitor" Grid.Column="1" Content="Mỗi màn hình 1 ảnh" Checked="Mode_Changed"/>
                        <RadioButton x:Name="rbModeSpan" Grid.Column="2" Content="Trải rộng (Span)" Checked="Mode_Changed"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblScale" Text="Căn chỉnh (Scale):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cbScale" Grid.Column="1" SelectionChanged="Scale_SelectionChanged">
                            <ComboBoxItem Content="Fill — Cắt vừa khung (Khuyên dùng)" Tag="Fill"/>
                            <ComboBoxItem Content="Fit — Giữ nguyên tỉ lệ (Viền nền)" Tag="Fit"/>
                            <ComboBoxItem Content="Stretch — Kéo dãn full màn hình" Tag="Stretch"/>
                            <ComboBoxItem Content="Center — Đặt ở chính giữa" Tag="Center"/>
                            <ComboBoxItem Content="Tile — Lặp lại dạng caro" Tag="Tile"/>
                            <ComboBoxItem Content="Span — Trải rộng qua các màn" Tag="Span"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Global Source Card -->
            <Border x:Name="cardGlobalSource" Grid.Row="2" Background="#252538" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#3E3E58" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="lblSourceSection" Text="🌐 Nguồn hình nền" FontWeight="Bold" FontSize="14" Foreground="#89B4FA" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="rbSourceBing" Content="Bing Daily 4K (Tự động)" IsChecked="True" Checked="GlobalSource_Changed"/>
                        <RadioButton x:Name="rbSourceLocal" Content="Thư mục Local" Margin="20,0,0,0" Checked="GlobalSource_Changed"/>
                        <RadioButton x:Name="rbSourcePexels" Content="Pexels API (Online)" Margin="20,0,0,0" Checked="GlobalSource_Changed"/>
                    </StackPanel>

                    <!-- Local Config -->
                    <StackPanel x:Name="panelGlobalLocal" Visibility="Collapsed" Margin="0,0,0,5">
                        <TextBlock x:Name="lblLocalFolderPath" Text="Đường dẫn thư mục ảnh:" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtGlobalFolderPath"/>
                            <Button x:Name="btnBrowse" Content="📁 Chọn" Grid.Column="1" Width="70" Margin="8,0,0,0" Click="BtnBrowseGlobalFolder_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Pexels Config -->
                    <StackPanel x:Name="panelGlobalPexels" Visibility="Collapsed">
                        <TextBlock x:Name="lblPexelsApiKey" Text="Pexels API Key:" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtGlobalPexelsApiKey" Margin="0,0,0,8"/>
                        
                        <TextBlock x:Name="lblPexelsQuery" Text="Từ khóa tìm kiếm (nature, city, cyberpunk...):" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtGlobalPexelsQuery"/>
                    </StackPanel>

                    <!-- Bing Daily Info -->
                    <TextBlock x:Name="txtBingInfo" Text="✨ Tự động tải hình ảnh Ultra HD chất lượng cao mỗi ngày của Microsoft Bing. Không cần API key." 
                               Foreground="#A6E3A1" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 4. Per-Monitor Config Card -->
            <Border x:Name="cardPerMonitor" Grid.Row="3" Visibility="Collapsed" Background="#252538" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#3E3E58" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="lblPerMonitorSection" Text="🎛️ Cấu hình từng Màn hình" FontWeight="Bold" FontSize="14" Foreground="#89B4FA" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="listMonitors">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E2E" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#3E3E58" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold" Foreground="#CDD6F4" FontSize="13"/>
                                        <TextBlock Grid.Row="1" Text="{Binding DeviceName}" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 5. General Settings Card -->
            <Border Grid.Row="4" Background="#252538" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#3E3E58" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="lblGeneralSection" Text="⚙️ Cài đặt Chung &amp; Vận hành" FontWeight="Bold" FontSize="14" Foreground="#89B4FA" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblInterval" Text="Tần suất đổi (Phút):" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtInterval" Grid.Column="1" HorizontalContentAlignment="Center"/>
                        <TextBlock x:Name="lblMinutesUnit" Text="phút" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#A6ADC8"/>
                    </Grid>

                    <CheckBox x:Name="chkAutoStart" Content="Khởi động cùng Windows (Chạy ngầm 100% không chớp màn hình)"/>
                </StackPanel>
            </Border>

            <!-- 6. Blacklist Management Card -->
            <Border Grid.Row="5" Background="#252538" CornerRadius="8" Padding="16" Margin="0,0,0,18" BorderBrush="#3E3E58" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblBlacklistTitle" Text="🚫 Quản lý Danh sách chặn (Blacklist)" FontWeight="Bold" FontSize="13" Foreground="#F38BA8"/>
                        <TextBlock x:Name="lblBlacklistCount" Text="Số ảnh đã chặn: 0" FontSize="12" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="btnClearBlacklist" Content="🧹 Xóa danh sách chặn" Grid.Column="1" Width="160" Style="{StaticResource DangerButton}" Click="BtnClearBlacklist_Click"/>
                </Grid>
            </Border>

            <!-- 7. Action Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnChangeNow" Content="🔄 Đổi hình nền ngay" Width="180" Margin="0,0,12,0" Click="BtnChangeNow_Click"/>
                <Button x:Name="btnSave" Content="💾 Lưu &amp; Áp dụng" Width="160" Style="{StaticResource AccentButton}" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
