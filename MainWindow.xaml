<Window x:Class="BackgroundSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Auto Wallpaper Changer" Height="450" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        Visibility="Visible"
                        ToolTipText="Auto Wallpaper Changer"
                        IconSource="/Images/icon.ico"
                        TrayMouseDoubleClick="MyNotifyIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Mở cửa sổ" Click="MenuOpen_Click"/>
                    <MenuItem Header="Đổi ảnh ngay" Click="MenuChangeNow_Click"/>
                    <Separator/>
                    <MenuItem Header="Thoát" Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <TextBlock Text="Cấu hình Hình nền Tự động" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Source Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Nguồn ảnh:" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="rbLocal" Content="Thư mục Local" IsChecked="True" Checked="Source_Changed"/>
                <RadioButton x:Name="rbPexels" Content="Pexels API (Online)" Margin="20,0,0,0" Checked="Source_Changed"/>
            </StackPanel>
        </StackPanel>

        <!-- Local Config -->
        <StackPanel x:Name="panelLocal" Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Đường dẫn thư mục:" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtFolderPath" KeyDown="TextBox_KeyDown"/>
                <Button Content="Chọn" Grid.Column="1" Width="60" Margin="10,0,0,0" Click="BtnBrowse_Click"/>
            </Grid>
        </StackPanel>

        <!-- Pexels Config -->
        <StackPanel x:Name="panelPexels" Grid.Row="3" Margin="0,0,0,15" Visibility="Collapsed">
            <TextBlock Text="Pexels API Key:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtApiKey" Margin="0,0,0,10" KeyDown="TextBox_KeyDown"/>
            
            <TextBlock Text="Từ khoá tìm kiếm (ví dụ: nature, city, space):" Margin="0,0,0,5"/>
            <TextBox x:Name="txtQuery" KeyDown="TextBox_KeyDown"/>
        </StackPanel>

        <!-- General Config -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Tần suất đổi (Phút):" Margin="0,0,0,5"/>
            <TextBox x:Name="txtInterval" Width="100" HorizontalAlignment="Left" KeyDown="TextBox_KeyDown"/>

            <CheckBox x:Name="chkAutoStart" Content="Khởi động cùng Windows" Margin="0,15,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Đổi ảnh ngay" Width="100" Margin="0,0,10,0" Click="BtnChangeNow_Click"/>
            <Button Content="Lưu &amp; Bắt đầu" Width="120" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
