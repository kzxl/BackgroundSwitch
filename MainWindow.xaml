<Window x:Class="BackgroundSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BackgroundSwitch.Models"
        Title="{Binding AppTitleText}" Height="750" Width="780"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#11131F" Foreground="#F1F5F9"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern Dark Palette Tokens (AgentOption wpf-ui standards) -->
        <SolidColorBrush x:Key="BrushBgDark" Color="#11131F"/>
        <SolidColorBrush x:Key="BrushBgCard" Color="#181A28"/>
        <SolidColorBrush x:Key="BrushBgInput" Color="#1D2034"/>
        <SolidColorBrush x:Key="BrushBgHover" Color="#262A44"/>
        <SolidColorBrush x:Key="BrushBorderDefault" Color="#2E344E"/>
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="#23273C"/>
        <SolidColorBrush x:Key="BrushPrimaryAccent" Color="#818CF8"/>
        <SolidColorBrush x:Key="BrushPrimaryAccentDark" Color="#6366F1"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushDangerAccent" Color="#F38BA8"/>
        <SolidColorBrush x:Key="BrushSuccessAccent" Color="#A6E3A1"/>

        <!-- Typography & Control Templates -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushBgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushPrimaryAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushPrimaryAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushPrimaryAccent}"/>
                                <Setter TargetName="border" Property="Background" Value="#22253D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BrushBgInput}"/>
            <Setter Property="Foreground" Value="#11131F"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,16,8"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushBorderDefault}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#32385C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrushPrimaryAccent}"/>
            <Setter Property="Foreground" Value="#11131F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A5B4FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushPrimaryAccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrushDangerAccent}"/>
            <Setter Property="Foreground" Value="#11131F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5C2E7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBA0AC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Monitor Mode & Scale Card -->
                <RowDefinition Height="Auto"/> <!-- Global Source Card -->
                <RowDefinition Height="Auto"/> <!-- Per-Monitor List Card -->
                <RowDefinition Height="Auto"/> <!-- General Settings Card -->
                <RowDefinition Height="Auto"/> <!-- Blacklist Management Card -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header with Language Selector -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🖼️ BackgroundSwitch" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryAccent}"/>
                    <TextBlock Text="{Binding AppSubtitleText}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LanguageLabelText}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Width="160" SelectedValue="{Binding Language, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Song ngữ (Bilingual)" Tag="bilingual"/>
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- 2. Monitor Mode & Scaling Card -->
            <Border Grid.Row="1" Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding ModeSectionText}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimaryAccent}" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="{Binding ModeSyncedText}" IsChecked="{Binding IsModeSynced, Mode=TwoWay}"/>
                        <RadioButton Grid.Column="1" Content="{Binding ModePerMonitorText}" IsChecked="{Binding IsModePerMonitor, Mode=TwoWay}"/>
                        <RadioButton Grid.Column="2" Content="{Binding ModeSpanText}" IsChecked="{Binding IsModeSpan, Mode=TwoWay}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ScaleLabelText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding Scale, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Fill — Cắt vừa khung (Khuyên dùng)" Tag="{x:Static models:WallpaperScale.Fill}"/>
                            <ComboBoxItem Content="Fit — Giữ nguyên tỉ lệ (Viền nền)" Tag="{x:Static models:WallpaperScale.Fit}"/>
                            <ComboBoxItem Content="Stretch — Kéo dãn full màn hình" Tag="{x:Static models:WallpaperScale.Stretch}"/>
                            <ComboBoxItem Content="Center — Đặt ở chính giữa" Tag="{x:Static models:WallpaperScale.Center}"/>
                            <ComboBoxItem Content="Tile — Lặp lại dạng caro" Tag="{x:Static models:WallpaperScale.Tile}"/>
                            <ComboBoxItem Content="Span — Trải rộng qua các màn" Tag="{x:Static models:WallpaperScale.Span}"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Global Source Card -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding SourceSectionText}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimaryAccent}" Margin="0,0,0,10"/>

                    <!-- Provider Selection WrapPanel -->
                    <WrapPanel Margin="0,0,0,10">
                        <RadioButton Content="{Binding SourceBingText}" IsChecked="{Binding IsSourceBing, Mode=TwoWay}"/>
                        <RadioButton Content="{Binding SourceRedditText}" IsChecked="{Binding IsSourceReddit, Mode=TwoWay}"/>
                        <RadioButton Content="{Binding SourceWallhavenText}" IsChecked="{Binding IsSourceWallhaven, Mode=TwoWay}"/>
                        <RadioButton Content="{Binding SourceNasaText}" IsChecked="{Binding IsSourceNasa, Mode=TwoWay}"/>
                        <RadioButton Content="{Binding SourceLocalText}" IsChecked="{Binding IsSourceLocal, Mode=TwoWay}"/>
                        <RadioButton Content="{Binding SourcePexelsText}" IsChecked="{Binding IsSourcePexels, Mode=TwoWay}"/>
                        <RadioButton Content="{Binding SourceUnsplashText}" IsChecked="{Binding IsSourceUnsplash, Mode=TwoWay}"/>
                    </WrapPanel>

                    <!-- Reddit Config -->
                    <StackPanel Visibility="{Binding IsRedditPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding RedditSubLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding RedditSubreddit, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Wallhaven Config -->
                    <StackPanel Visibility="{Binding IsWallhavenPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding WallhavenQueryLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding WallhavenQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        
                        <TextBlock Text="{Binding WallhavenApiKeyLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding WallhavenApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Local Config -->
                    <StackPanel Visibility="{Binding IsLocalPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding LocalFolderPathLabelText}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LocalFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="{Binding BrowseBtnText}" Command="{Binding BrowseFolderCommand}" Grid.Column="1" Width="80" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Pexels Config (Default API key set) -->
                    <StackPanel Visibility="{Binding IsPexelsPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding PexelsApiKeyLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PexelsApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        
                        <TextBlock Text="{Binding PexelsQueryLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PexelsQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Unsplash Config -->
                    <StackPanel Visibility="{Binding IsUnsplashPanelVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding UnsplashQueryLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding UnsplashQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding UnsplashApiKeyLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding UnsplashApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Provider Info Notes -->
                    <TextBlock Text="{Binding ProviderDescription}" 
                               Foreground="{StaticResource BrushSuccessAccent}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. Per-Monitor Config Card -->
            <Border Visibility="{Binding IsPerMonitorVisible, Converter={StaticResource BoolToVis}}" Grid.Row="3" Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding PerMonitorSectionText}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimaryAccent}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgDark}" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                                        <TextBlock Grid.Row="1" Text="{Binding DeviceName}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 5. General Settings Card -->
            <Border Grid.Row="4" Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding GeneralSectionText}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushPrimaryAccent}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding IntervalLabelText}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="{Binding MinutesUnitText}" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Grid>

                    <CheckBox Content="{Binding AutoStartText}" IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- 6. Blacklist Management Card -->
            <Border Grid.Row="5" Background="{StaticResource BrushBgCard}" CornerRadius="8" Padding="16" Margin="0,0,0,18" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🚫 Blacklist" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushDangerAccent}"/>
                        <TextBlock Text="{Binding BlacklistCountText}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="{Binding ClearBlacklistBtnText}" Command="{Binding ClearBlacklistCommand}" Grid.Column="1" Width="160" Style="{StaticResource DangerButton}"/>
                </Grid>
            </Border>

            <!-- 7. Action Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding ChangeNowButtonText}" Command="{Binding ChangeNowCommand}" Width="190" Margin="0,0,12,0"/>
                <Button Content="{Binding SaveBtnText}" Command="{Binding SaveCommand}" Width="160" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
